OPENROUTER_API_KEY=
# 모델 변경은 여기서 (예: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini)
MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MAX_FIX_ATTEMPTS=5
# TEST_TIMEOUT=300
# PO가 CEO와 주고받는 질문 상한 (되면 알아서 멈춤)
# PO_MAX_QUESTIONS=20
# 응답 스트리밍 (0 으로 끄면 일반 호출)
# STREAMING=1
# 사고 모델 예시: MODEL=deepseek/deepseek-reasoner